{
  "name": "manupos-print-agent",
  "version": "1.2.0",
  "private": true,
  "description": "Local print service for ChaslayReborn WebPOS - silent ESC/POS to Windows default printer",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:exe": "pkg . --targets node18-win-x64 --output dist/chaslay-print-agent.exe",
    "build:setup": "pkg . --targets node18-win-x64 --output dist/chaslay-print-agent-setup.exe",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File ./build-installer.ps1"
  },
  "pkg": {
    "assets": [
      "win-raw-print.ps1"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
