DOMAIN=chaslay.com
ACME_EMAIL=admin@webprintmedia.swiss
PUBLIC_APP_URL=https://admin.chaslay.com

POSTGRES_DB=manupos
POSTGRES_USER=manupos
POSTGRES_PASSWORD=replace-with-strong-db-password

JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRY=24h
CORS_ALLOW_ALL=true

SEED_SUPERADMIN_EMAIL=admin@chaslay.com
SEED_SUPERADMIN_PASSWORD=ChaslayAdmin123!
SEED_SUPERADMIN_NAME=ManuPOS Admin

# Optional integrations (fallback; prefer merchant panel Adyen credentials)
ADYEN_API_KEY=
ADYEN_MERCHANT_ACCOUNT=
ADYEN_CLIENT_ID=
# Brevo (preferred for merchant invite emails)
BREVO_API_KEY=
BREVO_FROM_EMAIL=noreply@chaslay.com
BREVO_FROM_NAME=Chaslay
# Aliases also supported: SENDINBLUE_API_KEY, SIB_API_KEY, FROM_EMAIL

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@webprintmedia.swiss

# Point a wildcard DNS A/AAAA record *.DOMAIN at this host for shop subdomains
# Path shops always work: https://DOMAIN/shop/{slug}
PUBLIC_RECEIPT_BASE_URL=https://pay.chaslay.com
