PORT=3000
NODE_ENV=production

# PostgreSQL (docker-compose uses these names)
DATABASE_URL=postgres://foodtruck:change_me_strong_password@postgres:5432/foodtruckpos

# Default tenant for single-merchant installs
DEFAULT_TENANT_SLUG=demo

# POS / sync clients send this header: X-Api-Key
API_KEY=change_me_pos_api_key

# Used to hash activation codes (keep secret)
LICENSE_SECRET=change_me_license_secret_min_32_chars

# Public URLs (for Caddy / docs)
PUBLIC_API_URL=https://api.yourdomain.com
