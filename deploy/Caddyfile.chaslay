{
	email admin@chaslay.com
	on_demand_tls {
		ask http://api:3000/api/shop/tls-ask
	}
}

# Chaslay production — ManuPOS stack + Android /v1 API
api.chaslay.com {
	encode gzip zstd

	handle /health {
		reverse_proxy api:3000
	}

	handle /v1/receipts* {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy api:3000
	}
}

admin.chaslay.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /v1/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

shop.chaslay.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

pay.chaslay.com {
	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle /receipt/* {
		reverse_proxy dashboard:80
	}

	handle {
		reverse_proxy dashboard:80
	}
}

# Merchant subdomains: https://{subdomain}.chaslay.com
*.chaslay.com {
	tls {
		on_demand
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}

# Custom domains: CNAME Host → shop.chaslay.com (Host header = merchant domain)
https:// {
	tls {
		on_demand
	}

	encode gzip zstd

	handle /api/* {
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy dashboard:80
	}
}
